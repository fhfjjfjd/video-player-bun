{
  "name": "video-player",
  "version": "2.0.0",
  "description": "Trình phát video với backend Express + SQLite (TypeScript + Vite)",
  "main": "dist/server/server.js",
  "scripts": {
    "start": "node dist/server/server.js",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "db:start": "pg_ctl -D $PREFIX/var/lib/postgresql -l $PREFIX/var/log/postgresql.log start",
    "db:stop": "pg_ctl -D $PREFIX/var/lib/postgresql stop",
    "db:migrate": "node scripts/migrate-db.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "disable-devtool": "^0.3.9",
    "express": "^5.2.1",
    "hls.js": "^1.6.16",
    "multer": "^2.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.3",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
